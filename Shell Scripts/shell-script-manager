#!/bin/bash
cd /home/$USER/Desktop/'Shell Scripts'/
clear
highintred='\033[0;91m'
boldgreen='\033[1;32m'
boldblue='\033[1;34m'
reset='\033[0m'
maxargu='1'
if [[ "$#" -gt "$maxargu" ]]; then
	echo "Too many arguments."
	sleep 2
	exit
