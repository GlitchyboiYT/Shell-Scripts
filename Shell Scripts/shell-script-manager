						;;
					esac
				;;
			7)
				clear
				echo "You picked Fix Interface."
				read -p "Are you sure? [Y/N] " yn
				case $yn in
					[Yy])
						./Network/Me/fixint.sh
						;;
					[Nn])
						show_menu
						;;
					esac
				;;
			*)
				clear
				echo "Not an option."
				sleep 1
				;;
			esac
	}
