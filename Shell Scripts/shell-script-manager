	show_menu(){
		clear
		echo -e "${highintred}------------------------${reset}"
		echo -e "${highintred}--Shell-Script-Manager--${reset}"
		echo -e "${highintred}------------------------${reset}"
		echo
		echo "========================"
		echo -e "${boldgreen}[1] Hydra Automated${reset}"
		echo -e "${boldgreen}[2] MDK4 Automated${reset}"
		echo -e "${boldgreen}[3] Gobuster Automated${reset}"
		echo -e "${boldgreen}[4] John WiFi Automated${reset}"
		echo -e "${boldgreen}[5] dirb Automated"
		echo -e "${boldgreen}[6] Network Manager${reset}"
		echo -e "${boldgreen}[7] Fix Interface${reset}"
		echo "========================"
		echo
		echo "(To skip menu type ./shell-script-manager <choice> )"
		read -p "$(echo -e "${boldblue}Choice:${reset}")" opt
		case $opt in
			1)
				clear
				echo "You picked Hydra Automated."
				read -p "Are you sure? [Y/N] " yn
				case $yn in
					[Yy])
						./Bruteforcing/hydraautomated
						;;
					[Nn])
						show_menu
						;;
					esac
				;;
			2)
				clear
				echo "You picked MDK4 Automated."
				read -p "Are you sure? [Y/N] " yn
				case $yn in
					[Yy])
						./Network/Attack/mdk4automated
						;;
					[Nn])
						show_menu
						;;
					esac
				;;
			3)
				clear
				echo "You picked Gobuster Automated."
